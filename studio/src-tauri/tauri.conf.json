{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WebMAKER Studio",
  "version": "0.1.1",
  "identifier": "it.playmaker.webmaker-studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "WebMAKER Studio", "width": 1440, "height": 940, "minWidth": 900, "minHeight": 680 }],
    "security": { "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline';" }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
